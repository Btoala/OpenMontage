{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production recovery snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "snapshot_date",
    "checked_at_utc",
    "review_date",
    "status",
    "scope",
    "scope_limits",
    "verification_policy",
    "lineage_notes",
    "records"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.0"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 12000
    },
    "snapshot_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "checked_at_utc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "review_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "status": {
      "type": "string",
      "maxLength": 12000
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "scope_limits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 12000
      }
    },
    "verification_policy": {
      "type": "object",
      "required": [
        "independent",
        "author_reported",
        "picture_audio",
        "hashes",
        "persistence",
        "mixed_audio",
        "missing"
      ],
      "additionalProperties": false,
      "properties": {
        "independent": {
          "type": "string",
          "maxLength": 12000
        },
        "author_reported": {
          "type": "string",
          "maxLength": 12000
        },
        "picture_audio": {
          "type": "string",
          "maxLength": 12000
        },
        "hashes": {
          "type": "string",
          "maxLength": 12000
        },
        "persistence": {
          "type": "string",
          "maxLength": 12000
        },
        "mixed_audio": {
          "type": "string",
          "maxLength": 12000
        },
        "missing": {
          "type": "string",
          "maxLength": 12000
        }
      }
    },
    "lineage_notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "version",
          "description"
        ],
        "properties": {
          "project": {
            "type": "string",
            "maxLength": 12000
          },
          "version": {
            "type": "string",
            "maxLength": 12000
          },
          "description": {
            "type": "string",
            "maxLength": 12000
          }
        }
      }
    },
    "records": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project",
          "episode",
          "shot",
          "filename",
          "display_name",
          "category",
          "content_version",
          "storage_version",
          "storage_status",
          "content_origin",
          "recorded_location",
          "location_basis",
          "retrieval_link",
          "retrieval_kind",
          "sha256",
          "hash_basis",
          "size_bytes",
          "evidence_basis",
          "evidence_date",
          "evidence_link",
          "file_open",
          "picture",
          "audio",
          "performed_checks",
          "reported_checks",
          "limitations",
          "recovery_option",
          "parent_record",
          "attachment_label",
          "parent_content_sha256",
          "derivation_method"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "project": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "episode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "shot": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "filename": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "content_version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "storage_version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "storage_status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "content_origin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "recorded_location": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "location_basis": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "retrieval_link": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "retrieval_kind": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "hash_basis": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidence_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence_date": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "evidence_link": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "file_open": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "picture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "audio": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "performed_checks": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 12000
            }
          },
          "reported_checks": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 12000
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 12000
            }
          },
          "recovery_option": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "parent_record": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "attachment_label": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          },
          "parent_content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "derivation_method": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 12000
          }
        }
      }
    }
  }
}
